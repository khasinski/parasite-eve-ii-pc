# SPDX-License-Identifier: CC0-1.0
# Direct LLVM invocation avoids the public SDK Windows wrapper's command-line
# limit. SDK/LLVM are explicit read-only inputs; all outputs belong to PE2.
set(PS5 TRUE)
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(PS5_PAYLOAD_SDK "$ENV{PS5_PAYLOAD_SDK}" CACHE PATH "Public PS5 payload SDK")
set(PE2_LLVM_BIN "$ENV{PE2_LLVM_BIN}" CACHE PATH "LLVM binary directory")
foreach(_path "${PS5_PAYLOAD_SDK}/target/include" "${PE2_LLVM_BIN}/clang.exe")
    if(NOT EXISTS "${_path}")
        message(FATAL_ERROR "Missing explicit PS5 toolchain input: ${_path}")
    endif()
endforeach()
set(CMAKE_SYSROOT "${PS5_PAYLOAD_SDK}/target")
set(CMAKE_C_COMPILER "${PE2_LLVM_BIN}/clang.exe")
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER "${PE2_LLVM_BIN}/clang++.exe")
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR "${PE2_LLVM_BIN}/llvm-ar.exe")
set(CMAKE_RANLIB "${PE2_LLVM_BIN}/llvm-ranlib.exe")
set(CMAKE_LINKER "${PE2_LLVM_BIN}/ld.lld.exe")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES PS5_PAYLOAD_SDK PE2_LLVM_BIN)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_C_FLAGS_INIT "-isystem \"${PS5_PAYLOAD_SDK}/target/include\" -fPIC -fno-stack-protector -fno-plt -femulated-tls -ffunction-sections -fdata-sections -D__BSD_VISIBLE=1")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT} -fno-exceptions -fno-rtti")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
